---
import Base from '../../layouts/Base.astro';
import MenuPage from '../../components/pages/MenuPage.astro';
import { LANGS } from '../../utils/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { dict } = Astro.locals;
---
<Base pageKey="menu" title={dict.menu.heading} path="/menu/">
  <MenuPage />
</Base>
