---
import { type Lang, getDict, SOCIAL } from '../utils/i18n';
import IgEmbed from './IgEmbed.astro';
import featuredPosts from '../data/featured-posts.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const dict = getDict(lang);
const urls: string[] = (featuredPosts.urls ?? []).filter(Boolean);
const hasPosts = urls.length > 0;
---
<section class="section-cream">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <div class="flex items-end justify-between gap-6 flex-wrap">
      <h2 class="font-display text-3xl md:text-4xl">{dict.schedule.instaHeading}</h2>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="btn-primary">@bkc_yu_____me</a>
    </div>
    <div class="mt-8">
      {hasPosts ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center [&>*]:w-full [&>*]:max-w-md">
          {urls.map((url) => <IgEmbed url={url} />)}
        </div>
      ) : (
        <div class="grid grid-cols-3 gap-2 md:gap-3">
          {Array.from({ length: 9 }).map(() => (
            <div class="aspect-square bg-placeholder rounded-soft flex items-center justify-center text-cream/40 text-[10px] md:text-xs text-center p-2">
              {dict.schedule.instaPlaceholder}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
{hasPosts && (
  <script is:inline>
    (function() {
      function process() { try { window.instgrm && window.instgrm.Embeds && window.instgrm.Embeds.process(); } catch (e) {} }
      if (window.instgrm) {
        process();
        return;
      }
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.instagram.com/embed.js';
      s.onload = process;
      document.body.appendChild(s);
    })();
  </script>
)}
