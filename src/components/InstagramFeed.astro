---
import { type Lang, getDict, SOCIAL } from '../utils/i18n';

interface Props { lang: Lang; beholdId?: string; }
const { lang, beholdId } = Astro.props;
const dict = getDict(lang);
---
<section class="section-cream">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <div class="flex items-end justify-between gap-6 flex-wrap">
      <h2 class="font-display text-3xl md:text-4xl">{dict.schedule.instaHeading}</h2>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="btn-primary">@bkc_yu_____me</a>
    </div>
    <div class="mt-8">
      {beholdId ? (
        <div data-behold-id={beholdId}></div>
      ) : (
        <div class="grid grid-cols-3 gap-2 md:gap-3">
          {Array.from({ length: 9 }).map(() => (
            <div class="aspect-square bg-placeholder rounded-soft flex items-center justify-center text-cream/40 text-[10px] md:text-xs text-center p-2">
              {dict.schedule.instaPlaceholder}
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
{beholdId && <script type="module" src={`https://w.behold.so/widget.js`}></script>}
