---
import { type PageKey, basePath, PAGE_PATH } from '../utils/i18n';
import LangSwitch from './LangSwitch.astro';

interface Props { pageKey: PageKey; }
const { pageKey } = Astro.props;
const { lang, dict } = Astro.locals;

const nav = (Object.keys(PAGE_PATH) as PageKey[]).map((key) => ({
  key,
  label: dict.nav[key],
  href: basePath(lang, PAGE_PATH[key])
}));
---
<header class="sticky top-0 z-40 bg-ink text-cream border-b border-cream/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={basePath(lang, '')} class="font-display text-2xl tracking-wide">
      BKC <span class="text-berry">ゆめ</span>
    </a>
    <nav class="hidden md:flex items-center gap-7">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-bold text-sm transition hover:text-berry',
            pageKey === item.key ? 'text-berry' : 'text-cream'
          ]}
        >{item.label}</a>
      ))}
      <LangSwitch pageKey={pageKey} variant="dark" />
    </nav>
    <button
      id="nav-toggle"
      class="md:hidden text-cream text-2xl"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >☰</button>
  </div>
  <div id="mobile-nav" class="md:hidden hidden bg-ink border-t border-cream/10">
    <div class="px-4 py-4 flex flex-col gap-4">
      <LangSwitch pageKey={pageKey} variant="dark" />
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-bold py-2 border-b border-cream/10',
            pageKey === item.key ? 'text-berry' : 'text-cream'
          ]}
        >{item.label}</a>
      ))}
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
