---
import { SOCIAL } from '../utils/i18n';

const { dict } = Astro.locals;
const year = new Date().getFullYear();
---
<footer class="bg-ink text-cream pt-12 pb-28 md:pb-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 grid gap-8 md:grid-cols-3">
    <div>
      <div class="font-display text-3xl">BKC <span class="text-berry">ゆめ</span></div>
      <p class="mt-3 text-cream/80 text-sm leading-relaxed">{dict.footer.tagline}</p>
    </div>
    <div class="text-sm">
      <div class="font-bold mb-2 text-berry">Contact</div>
      <ul class="space-y-2">
        <li><a class="hover:text-berry" href={SOCIAL.instagramDM} target="_blank" rel="noopener">Instagram DM</a></li>
        <li><a class="hover:text-berry" href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a class="hover:text-berry" href={SOCIAL.threads} target="_blank" rel="noopener">Threads</a></li>
        <li><a class="hover:text-berry" href={SOCIAL.email}>Email</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <div class="font-bold mb-2 text-berry">Area</div>
      <p class="text-cream/80 leading-relaxed">{dict.footer.area}</p>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 mt-10 pt-6 border-t border-cream/10 flex flex-col md:flex-row md:justify-between gap-2 text-xs text-cream/60">
    <div>{dict.footer.rights} {year}</div>
    <div>Made with ♡ in Joetsu / Myoko</div>
  </div>
</footer>
