---
import { basePath, SOCIAL } from '../../utils/i18n';
import SectionHeading from '../SectionHeading.astro';
import NextEventBanner from '../NextEventBanner.astro';
import MenuCard from '../MenuCard.astro';
import menuData from '../../data/menu.json';

const { lang, dict } = Astro.locals;
const featured = menuData.items.filter((i) => i.featured).slice(0, 3);
---
<!-- Hero -->
<section class="section-ink relative overflow-hidden min-h-[85vh] flex items-center">
  <div class="absolute inset-0 pointer-events-none">
    <img
      src="/images/parfait-black.jpg"
      alt=""
      width="1600"
      height="2000"
      class="w-full h-full object-cover scale-[1.6] origin-center opacity-80"
      aria-hidden="true"
      role="presentation"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-ink/80 via-ink/60 to-ink/85"></div>
  </div>
  <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
    <div class="absolute top-10 left-10 text-berry text-9xl">♡</div>
    <div class="absolute bottom-20 right-14 text-caramel text-8xl">★</div>
    <div class="absolute top-1/2 right-1/3 text-berry text-7xl">♡</div>
  </div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-20 md:py-28 w-full">
    <div class="text-xs font-bold tracking-[0.2em] text-berry">{dict.hero.eyebrow}</div>
    <h1 class="mt-4 font-display text-5xl sm:text-7xl md:text-8xl leading-[0.9] whitespace-pre-line">
      {dict.hero.title}
    </h1>
    <p class="mt-6 max-w-xl text-cream/80 leading-relaxed">{dict.hero.body}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 items-start">
      <a href={basePath(lang, 'schedule')} class="btn-primary">→ {dict.hero.ctaPrimary}</a>
      <a href={basePath(lang, 'menu')} class="btn-outline-cream">{dict.hero.ctaSecondary}</a>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="px-4 py-3 font-bold text-cream/80 hover:text-berry underline underline-offset-4 decoration-berry/40 hover:decoration-berry">
        {dict.hero.ctaTertiary}
      </a>
    </div>
  </div>
</section>

<!-- Next event banner -->
<NextEventBanner variant="banner" />

<!-- About excerpt -->
<section class="section-cream">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24 grid md:grid-cols-2 gap-10 items-center">
    <div class="aspect-[4/5] rounded-card overflow-hidden bg-ink">
      <img
        src="/images/parfait-black.jpg"
        alt={dict.aboutExcerpt.heading}
        width="800"
        height="1000"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <SectionHeading title={dict.aboutExcerpt.heading} />
      <p class="mt-6 text-base md:text-lg leading-relaxed opacity-80 max-w-lg">{dict.aboutExcerpt.body}</p>
      <a href={basePath(lang, 'about')} class="btn-outline mt-8">{dict.aboutExcerpt.cta} →</a>
    </div>
  </div>
</section>

<!-- Menu preview -->
<section class="section-ink">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-24">
    <SectionHeading title={dict.menuPreview.heading} align="center" />
    <div class="mt-10 grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      {featured.map((i) => <MenuCard itemId={i.id} />)}
    </div>
    <div class="mt-10 text-center">
      <a href={basePath(lang, 'menu')} class="btn-outline-cream">{dict.menuPreview.cta} →</a>
    </div>
  </div>
</section>

<!-- Instagram CTA -->
<section class="section-cream">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
    <div class="rounded-card bg-berry text-cream p-10 md:p-16 text-center">
      <div class="font-display text-4xl md:text-6xl leading-tight">@bkc_yu_____me</div>
      <p class="mt-4 text-cream/90 max-w-xl mx-auto">{dict.instaCta.body}</p>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="mt-8 inline-flex items-center justify-center gap-2 rounded-soft bg-ink text-cream px-8 py-4 font-bold hover:opacity-90">
        Instagram →
      </a>
    </div>
  </div>
</section>
