---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { type Lang, type PageKey, getDict } from '../utils/i18n';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title?: string;
  description?: string;
  path: string;
}

const { lang, pageKey, title, description, path } = Astro.props;
const dict = getDict(lang);
const fullTitle = title ? `${title} | ${dict.meta.siteName}` : dict.meta.titleBase;
const desc = description ?? dict.meta.description;
const canonical = `https://bkc-yume.pages.dev/${lang}${path}`;
const alt = lang === 'ja' ? 'en' : 'ja';
const altPath = `https://bkc-yume.pages.dev/${alt}${path}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0B0C" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={`https://bkc-yume.pages.dev/ja${path}`} />
    <link rel="alternate" hreflang="en" href={`https://bkc-yume.pages.dev/en${path}`} />
    <link rel="alternate" hreflang="x-default" href={`https://bkc-yume.pages.dev/ja${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/og.svg" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FoodEstablishment',
      name: dict.meta.siteName,
      description: dict.meta.description,
      url: canonical,
      servesCuisine: 'Dessert / Parfait',
      priceRange: '¥800-¥1,000',
      areaServed: [
        { '@type': 'City', name: 'Joetsu' },
        { '@type': 'City', name: 'Myoko' },
        { '@type': 'City', name: 'Itoigawa' }
      ],
      sameAs: [
        'https://instagram.com/bkc_yu____me',
        'https://www.threads.net/@bkc_yu____me'
      ]
    })} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-berry focus:text-cream focus:px-3 focus:py-2 focus:rounded-soft">Skip to content</a>
    <Header lang={lang} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCTA lang={lang} />
  </body>
</html>
